{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "moduleResolution": "node",
  },
  "dependencies": {
  "@gated/shared": "*"
  },
  "include": [
    "src/**/*.ts",
    "src/app.ts",
    "types/**/*.d.ts", "../../packages/shared/src/constants/userLimits.ts",
  ], // Include all TypeScript files in the src folder
  "exclude": ["node_modules", "dist", "src/utils/updaterScripts"] // Exclude these folders
}
